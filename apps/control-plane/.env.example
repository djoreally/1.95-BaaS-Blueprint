# Control-plane bookkeeping database
DATABASE_URL=

# 32-byte control-plane secret used by lib/crypto.ts
CONTROL_PLANE_ENCRYPTION_KEY=

# Separate signing secret for customer login sessions.
# Generate a long random value for production.
SESSION_SECRET=

# Canonical public URL for Checkout success/cancel and Customer Portal returns.
NEXT_PUBLIC_APP_URL=https://baas.example.com

# Email identity that owns the platform cPanel connection used by HOSTED tenants.
# Existing installs can leave this unset to use owner@local.
PLATFORM_OWNER_EMAIL=

# Managed paid tier. Set this to a domain that already belongs to the platform
# owner's cPanel account. Hosted customer projects become <project>.<domain>.
# If omitted, the saved platform hosting connection's main domain is used.
HOSTED_BASE_DOMAIN=

# Stripe Billing — server only. Never expose STRIPE_SECRET_KEY or the webhook secret.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_FIRST_MONTH_COUPON_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
