# Control-plane bookkeeping database
DATABASE_URL=

# 32-byte control-plane secret used by lib/crypto.ts
CONTROL_PLANE_ENCRYPTION_KEY=

# Managed paid tier. Set this to a domain that already belongs to the platform
# owner's cPanel account. Hosted customer projects become <project>.<domain>.
# If omitted, the saved platform hosting connection's main domain is used.
HOSTED_BASE_DOMAIN=
