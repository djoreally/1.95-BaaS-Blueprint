// Prisma schema for the InvisibleDB control plane.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("user")
  provisionRequests ProvisionRequest[]
  runtimeCommands RuntimeCommand[]
  instanceStates InstanceState[]
  instanceCredentials InstanceCredential[]
  apiKeys ControlPlaneApiKey[]
  migrationJobs MigrationJob[]
  createdAt    DateTime @default(now())

  connections  HostingConnection[]
  projects     Project[]
  subscriptions BillingSubscription[]
}

model HostingConnection {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             String?
  host              String
  username          String
  apiTokenEncrypted String   @db.Text
  mainDomain        String?
  domains           String[] @default([])
  createdAt         DateTime @default(now())
  projects Project[]
  @@index([userId])
}

model Project {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?
  connection   HostingConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  name         String
  domain       String
  fqdn         String
  port         Int
  dbName       String?
  dbUser       String?
  status       String    @default("provisioning")
  steps        Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@index([userId])
  @@index([connectionId])
}

model BillingSubscription {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId      String?
  stripeSubscriptionId  String?  @unique
  stripePriceId         String?
  status                String   @default("incomplete")
  entitlementActive     Boolean  @default(false)
  cancelAtPeriodEnd     Boolean  @default(false)
  currentPeriodEnd      DateTime?
  lastStripeEventAt     DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@index([userId])
  @@index([stripeCustomerId])
}

model ProvisionRequest {
  id        String   @id @default(cuid())
  kind      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  slug      String
  status    String   @default("pending")
  attempts  Int      @default(0)
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
}

model RuntimeCommand {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                   String
  kind                   String
  payload                Json?
  status                 String    @default("pending")
  attempts               Int       @default(0)
  result                  Json?
  secretResultEncrypted  String?   @db.Text
  claimedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  @@index([status, createdAt])
  @@index([userId, slug, createdAt])
}

model InstanceState {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug       String
  snapshot   Json
  observedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([userId, slug])
  @@index([slug])
}

model InstanceCredential {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug            String
  apiKeyEncrypted String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([userId, slug])
  @@index([slug])
}

model ControlPlaneApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  @@index([userId, createdAt])
}

model MigrationJob {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug           String
  sourceProvider String
  status         String    @default("planned")
  manifest       Json
  plan           Json
  progress       Json?
  verification   Json?
  error          String?   @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  batches        MigrationBatch[]
  @@index([userId, slug, createdAt])
  @@index([status, updatedAt])
}

model MigrationBatch {
  id          String       @id @default(cuid())
  migrationId String
  migration   MigrationJob @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  batchKey    String
  collection  String
  checksum    String?
  received    Int          @default(0)
  imported    Int          @default(0)
  status      String       @default("pending")
  error       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@unique([migrationId, batchKey])
  @@index([migrationId, collection])
}
