# Copy to /srv/idb/.env on the VPS. Never commit the real one.
BASE_DOMAIN=invisibledb.app
ACME_EMAIL=ops@invisibledb.app
# Control plane (billing webhook -> provision queue -> this box polls it)
CONTROL_PLANE_URL=https://baas.invisibledb.app
VPS_API_SECRET=  # shared secret, must match control plane env
# PB_VERSION is baked at image build time (pocketbase/Dockerfile ARG).
