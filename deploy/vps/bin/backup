#!/usr/bin/env bash
# Nightly/manual SQLite backup for one or all customers.
# Uses sqlite3 .backup (online, no downtime) inside each running container,
# then compresses. Retention: newest 11 snapshots per customer.
# Off-box copy is handled separately by the host rsync cron.
# Usage: backup [slug]   (no slug = all customers)
set -euo pipefail
umask 077

IDB_ROOT="${IDB_ROOT:-/srv/idb}"
BACKUP_DIR="$IDB_ROOT/backups"
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

backup_one() {
  local slug="$1" name="idb-$1"
  local stamp; stamp="$(date -u +%F-%H%M%S)"
  local tmp="/tmp/$name-$stamp.db"
  docker exec "$name" sqlite3 /pb/data/data.db ".backup '$tmp'" 2>/dev/null || {
    echo "skip $slug (not running?)" >&2; return 1
  }
  docker cp "$name:$tmp" "$BACKUP_DIR/$slug-$stamp.db" >/dev/null
  docker exec "$name" rm -f "$tmp" >/dev/null
  chmod 600 "$BACKUP_DIR/$slug-$stamp.db"
  gzip -f "$BACKUP_DIR/$slug-$stamp.db"
  chmod 600 "$BACKUP_DIR/$slug-$stamp.db.gz"
  echo "backed up $slug -> $slug-$stamp.db.gz"
}

if [[ "${1:-}" != "" ]]; then
  backup_one "$1"
else
  for c in $(docker ps --format '{{.Names}}' | grep '^idb-' | grep -v -E '^idb-(caddy|gateway)(-|$)' || true); do
    backup_one "${c#idb-}"
  done
fi

# Keep the 11 newest snapshots per customer. The timestamped filenames allow
# multiple safe backups on the same day (manual backup + pre-restore backup).
for slug in $(find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.db.gz' -printf '%f\n' | sed -E 's/-[0-9]{4}-[0-9]{2}-[0-9]{2}(-[0-9]{6})?\.db\.gz$//' | sort -u); do
  ls -t "$BACKUP_DIR/$slug"-*.db.gz 2>/dev/null | tail -n +12 | xargs -r rm -f
done
