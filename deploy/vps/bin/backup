#!/usr/bin/env bash
# Nightly/manual SQLite backup for one or all customers.
# Uses a one-shot helper container with sqlite3 against the tenant named volume,
# so backup safety does not depend on utilities installed in the running tenant.
# SQLite .backup is online-safe; the customer container remains running.
# Retention: newest 11 snapshots per customer.
# Off-box copy is handled separately by the host rsync cron.
# Usage: backup [slug]   (no slug = all customers)
set -euo pipefail
umask 077

IDB_ROOT="${IDB_ROOT:-/srv/idb}"
BACKUP_DIR="$IDB_ROOT/backups"
BACKUP_IMAGE="${IDB_BACKUP_IMAGE:-idb-pocketbase:vec}"
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

backup_one() {
  local slug="$1" name="idb-$1" volume="$name-data"
  local stamp out
  stamp="$(date -u +%F-%H%M%S)"
  out="$slug-$stamp.db"

  if ! docker inspect "$name" >/dev/null 2>&1; then
    echo "skip $slug (container not found)" >&2
    return 1
  fi
  if [[ "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null || true)" != "true" ]]; then
    echo "skip $slug (container not running)" >&2
    return 1
  fi
  if ! docker volume inspect "$volume" >/dev/null 2>&1; then
    echo "skip $slug (volume $volume not found)" >&2
    return 1
  fi
  if ! docker image inspect "$BACKUP_IMAGE" >/dev/null 2>&1; then
    echo "backup helper image $BACKUP_IMAGE is not available" >&2
    return 1
  fi

  # Mount the tenant volume and backup directory into a short-lived helper.
  # --entrypoint bypasses PocketBase; root is used only inside this ephemeral
  # helper so it can read the existing database regardless of tenant UID.
  docker run --rm \
    --user 0:0 \
    --network none \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --entrypoint sqlite3 \
    -v "$volume:/pb/data" \
    -v "$BACKUP_DIR:/backup" \
    "$BACKUP_IMAGE" \
    /pb/data/data.db ".backup '/backup/$out'" >/dev/null

  chmod 600 "$BACKUP_DIR/$out"

  # Refuse to keep a backup that SQLite itself cannot read cleanly.
  local integrity
  integrity="$(docker run --rm \
    --user 0:0 \
    --network none \
    --cap-drop ALL \
    --security-opt no-new-privileges:true \
    --entrypoint sqlite3 \
    -v "$BACKUP_DIR:/backup:ro" \
    "$BACKUP_IMAGE" \
    "/backup/$out" 'PRAGMA integrity_check;' 2>/dev/null || true)"
  if [[ "$integrity" != "ok" ]]; then
    rm -f "$BACKUP_DIR/$out"
    echo "backup integrity check failed for $slug: ${integrity:-no result}" >&2
    return 1
  fi

  gzip -f "$BACKUP_DIR/$out"
  chmod 600 "$BACKUP_DIR/$out.gz"
  echo "backed up $slug -> $out.gz"
}

if [[ "${1:-}" != "" ]]; then
  backup_one "$1"
else
  for c in $(docker ps --format '{{.Names}}' | grep '^idb-' | grep -v -E '^idb-(caddy|gateway)(-|$)' || true); do
    backup_one "${c#idb-}"
  done
fi

# Keep the 11 newest snapshots per customer. The timestamped filenames allow
# multiple safe backups on the same day (manual backup + pre-restore backup).
for slug in $(find "$BACKUP_DIR" -maxdepth 1 -type f -name '*.db.gz' -printf '%f\n' | sed -E 's/-[0-9]{4}-[0-9]{2}-[0-9]{2}(-[0-9]{6})?\.db\.gz$//' | sort -u); do
  ls -t "$BACKUP_DIR/$slug"-*.db.gz 2>/dev/null | tail -n +12 | xargs -r rm -f
done
