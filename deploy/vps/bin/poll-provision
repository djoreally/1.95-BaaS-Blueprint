#!/usr/bin/env bash
# InvisibleDB VPS worker — host cron every 2 minutes.
# 1) pulls provision/deprovision jobs
# 2) pulls runtime control commands
# The box never talks to Stripe and accepts work only from the authenticated
# control-plane queues.
#
# Env (in /srv/idb/.env): CONTROL_PLANE_URL, VPS_API_SECRET
# Cron: */2 * * * * root /srv/idb/bin/poll-provision >>/var/log/idb-poll.log 2>&1
set -euo pipefail

IDB_ROOT="${IDB_ROOT:-/srv/idb}"
# shellcheck source=/dev/null
source "$IDB_ROOT/.env"

AUTH="Authorization: Bearer $VPS_API_SECRET"

# ---------------- provisioning queue ----------------
RESP="$(curl -s -m 20 -H "$AUTH" "$CONTROL_PLANE_URL/api/vps/requests")"

echo "$RESP" | python3 -c "
import json, sys, subprocess, urllib.request

IDB_ROOT = '$IDB_ROOT'
AUTH = 'Bearer $VPS_API_SECRET'
CP = '$CONTROL_PLANE_URL'

def report(rid, ok, detail=''):
    req = urllib.request.Request(
        CP + '/api/vps/requests',
        data=json.dumps({'id': rid, 'ok': ok, 'detail': detail}).encode(),
        headers={'Authorization': AUTH, 'Content-Type': 'application/json'},
        method='POST')
    urllib.request.urlopen(req, timeout=20).read()

try:
    data = json.loads(sys.stdin.read())
except Exception as e:
    sys.exit(f'bad queue response: {e}')

for r in data.get('requests', []):
    rid, kind, email, slug = r['id'], r['kind'], r['email'], r['slug']
    try:
        if kind == 'provision':
            out = subprocess.run([IDB_ROOT + '/bin/provision', slug, email],
                                 capture_output=True, text=True, timeout=300)
        else:
            out = subprocess.run([IDB_ROOT + '/bin/deprovision', slug],
                                 capture_output=True, text=True, timeout=300)
        ok = out.returncode == 0
        tail = (out.stdout + out.stderr)[-500:].replace('idb_live_', 'idb_live_***')
        report(rid, ok, tail if not ok else 'completed')
        print(('ok ' if ok else 'FAIL ') + kind + ' ' + slug)
    except Exception as e:
        report(rid, False, str(e)[:500])
        print('FAIL ' + kind + ' ' + slug + ': ' + str(e)[:200])
"

# ---------------- runtime command queue ----------------
CMD_RESP="$(curl -s -m 20 -H "$AUTH" "$CONTROL_PLANE_URL/api/vps/commands")"

echo "$CMD_RESP" | python3 -c "
import json, sys, subprocess, urllib.request

IDB_ROOT = '$IDB_ROOT'
AUTH = 'Bearer $VPS_API_SECRET'
CP = '$CONTROL_PLANE_URL'

def report(cid, ok, result, secret=None):
    payload = {'id': cid, 'ok': ok, 'result': result}
    if secret:
        payload['secret'] = secret
    req = urllib.request.Request(
        CP + '/api/vps/commands',
        data=json.dumps(payload).encode(),
        headers={'Authorization': AUTH, 'Content-Type': 'application/json'},
        method='POST')
    urllib.request.urlopen(req, timeout=20).read()

try:
    data = json.loads(sys.stdin.read())
except Exception as e:
    sys.exit(f'bad runtime queue response: {e}')

for command in data.get('commands', []):
    cid = command['id']
    kind = command['kind']
    slug = command['slug']
    payload = command.get('payload') or {}
    try:
        out = subprocess.run(
            ['python3', IDB_ROOT + '/bin/runtime-command', kind, slug, json.dumps(payload)],
            capture_output=True, text=True, timeout=360)
        try:
            result = json.loads(out.stdout.strip().splitlines()[-1]) if out.stdout.strip() else {'error': out.stderr[-1000:]}
        except Exception:
            result = {'error': (out.stdout + out.stderr)[-1000:]}
        secret = result.pop('secret', None) if isinstance(result, dict) else None
        ok = out.returncode == 0
        report(cid, ok, result, secret)
        print(('ok ' if ok else 'FAIL ') + 'runtime ' + kind + ' ' + slug)
    except Exception as e:
        report(cid, False, {'error': str(e)[:1000]})
        print('FAIL runtime ' + kind + ' ' + slug + ': ' + str(e)[:200])
"
