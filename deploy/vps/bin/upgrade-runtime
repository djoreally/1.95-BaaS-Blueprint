#!/usr/bin/env bash
# Upgrade the InvisibleDB runtime on an already-provisioned VPS.
# Assumes the updated deploy/vps directory has already been synced to /srv/idb.
# Data volumes, keys, Caddy data, backups and .env are never deleted.
set -euo pipefail

IDB_ROOT="${IDB_ROOT:-/srv/idb}"
cd "$IDB_ROOT"
source "$IDB_ROOT/.env"

NEW_IMAGE="idb-pocketbase:vec"
OLD_IMAGE="idb-pocketbase:latest"

log() { printf '[upgrade] %s\n' "$*"; }

log "building vec-capable PocketBase runtime"
docker build -f pocketbase/Dockerfile.vec -t "$NEW_IMAGE" pocketbase

log "rebuilding gateway with end-user/server-key split"
docker compose build gateway
docker compose up -d gateway caddy

start_tenant() {
  local name="$1" image="$2" volume="$3"
  docker run -d --name "$name" \
    --restart unless-stopped \
    --network idb_idb-net \
    --memory 256m --memory-swap 256m \
    --pids-limit 128 \
    -v "$volume:/pb/data" \
    "$image" \
    serve --http=0.0.0.0:8090 --dir=/pb/data >/dev/null
}

upgrade_one() {
  local name="$1" slug="${1#idb-}" volume="${1}-data"
  log "creating safety backup for $slug"
  "$IDB_ROOT/bin/backup" "$slug"

  log "upgrading $slug to $NEW_IMAGE"
  docker stop "$name" >/dev/null
  docker rm "$name" >/dev/null

  # Wait until Docker/containerd has fully released the old container state.
  for _ in $(seq 1 10); do
    if ! docker inspect "$name" >/dev/null 2>&1; then break; fi
    sleep 1
  done
  sleep 1

  if ! start_tenant "$name" "$NEW_IMAGE" "$volume"; then
    log "initial start failed for $slug; retrying once after container cleanup"
    docker rm -f "$name" >/dev/null 2>&1 || true
    sleep 2
    if ! start_tenant "$name" "$NEW_IMAGE" "$volume"; then
      log "failed to start new image for $slug; rolling back"
      docker rm -f "$name" >/dev/null 2>&1 || true
      start_tenant "$name" "$OLD_IMAGE" "$volume"
      return 1
    fi
  fi

  local ok=0
  for _ in $(seq 1 45); do
    if docker exec "$name" wget -q -O /dev/null http://localhost:8090/api/health 2>/dev/null; then ok=1; break; fi
    sleep 2
  done

  if [[ "$ok" != "1" ]]; then
    log "health check failed for $slug; new runtime logs follow"
    docker logs --tail 100 "$name" 2>&1 || true
    log "rolling back without touching its volume"
    docker rm -f "$name" >/dev/null 2>&1 || true
    start_tenant "$name" "$OLD_IMAGE" "$volume"
    return 1
  fi

  log "$slug healthy on vec runtime"
}

mapfile -t tenants < <(docker ps -a --format '{{.Names}}' | grep '^idb-' | grep -v -E '^idb-(caddy|gateway)(-|$)' || true)
for tenant in "${tenants[@]}"; do
  upgrade_one "$tenant"
done

chmod +x "$IDB_ROOT/bin/"*

log "runtime upgrade complete"
GATEWAY_NAME="$(docker compose ps -q gateway)"
if [[ -n "$GATEWAY_NAME" ]] && docker exec "$GATEWAY_NAME" wget -q -O - http://localhost:8080/healthz >/dev/null 2>&1; then
  log "gateway: healthy"
else
  log "gateway: FAILED"
fi
docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}' | grep '^idb-' || true
