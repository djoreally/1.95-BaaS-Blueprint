# PocketBase + sqlite-vec custom build used by InvisibleDB tenants.
# Build on the VPS:
#   docker build -f Dockerfile.vec -t idb-pocketbase:vec ./pocketbase

ARG PB_VERSION=0.36.5
ARG VEC_VERSION=v0.1.6

FROM golang:1.24-bookworm AS build
ARG PB_VERSION
ARG VEC_VERSION
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential libsqlite3-dev wget ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src

# Keep PocketBase at a pinned version so the custom runtime and API contract are reproducible.
RUN wget -q "https://github.com/pocketbase/pocketbase/archive/refs/tags/v${PB_VERSION}.tar.gz" \
      -O pb.tar.gz && tar xzf pb.tar.gz --strip-components=1 && rm pb.tar.gz

# Build our main package outside the PocketBase package root to avoid mixed-package imports.
RUN mkdir -p /src/cmd/invisibledb
COPY --chmod=644 main_vec.go /src/cmd/invisibledb/main.go

RUN go get github.com/asg017/sqlite-vec-go-bindings@${VEC_VERSION} && \
    go get github.com/mattn/go-sqlite3 && \
    CGO_ENABLED=1 go build -tags no_default_driver -o /pb/pocketbase ./cmd/invisibledb

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libsqlite3-0 wget passwd && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system --gid 1000 pocketbase && \
    useradd --system --uid 1000 --gid 1000 --home /pb --create-home pocketbase && \
    mkdir -p /pb/data && chown -R pocketbase:pocketbase /pb
COPY --from=build /pb/pocketbase /usr/local/bin/pocketbase
USER pocketbase
WORKDIR /pb
VOLUME ["/pb/data"]
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:8090/api/health || exit 1
ENTRYPOINT ["pocketbase"]
